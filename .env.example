# Brightloop Subscription Management System Configuration

# Server Environment
PORT=5000
NODE_ENV=development

# JWT Secret
JWT_SECRET=brightloop_super_secret_jwt_key_2026_x_makeaton
JWT_EXPIRES_IN=24h

# PostgreSQL Configuration (Optional - falls back to SQLite embedded if not configured)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brightloop_subscriptions
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=brightloop_subscriptions

# Billing Engine Settings
BILLING_CRON_SCHEDULE="0 0 * * *"
AUTO_INVOICE_GENERATION=true
TAX_DEFAULT_PERCENTAGE=18.00

# Client Configuration
VITE_API_URL=http://localhost:5000/api
